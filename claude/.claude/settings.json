{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "mcp__claude_ai_Cloudflare_Developer_Platform"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh '/Applications/Claudio.app/Contents/Resources/attention-hook.sh' alert"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh '/Applications/Claudio.app/Contents/Resources/attention-hook.sh' clear"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/rtk hook claude"
          }
        ]
      },
      {
        "matcher": "mcp__chrome-devtools__(new_page|select_page)",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/jq -c '{hookSpecificOutput: {hookEventName: \"PreToolUse\", updatedInput: (.tool_input + (if .tool_name | endswith(\"__new_page\") then {background: true} else {bringToFront: false} end))}}'"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh '/Applications/Claudio.app/Contents/Resources/attention-hook.sh' alert"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh '/Applications/Claudio.app/Contents/Resources/attention-hook.sh' tool"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/eduardo/.claude/hooks/journal.sh' end",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh '/Applications/Claudio.app/Contents/Resources/attention-hook.sh' end"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/eduardo/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/eduardo/.claude/hooks/journal.sh' start",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "startup|resume|fork",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/eduardo/.claude/hooks/session-title.sh'",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh '/Applications/Claudio.app/Contents/Resources/attention-hook.sh' stop"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh '/Applications/Claudio.app/Contents/Resources/attention-hook.sh' subagent"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh '/Applications/Claudio.app/Contents/Resources/attention-hook.sh' clear"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "atlassian@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "code-review@claude-code-plugins": true,
    "herdr-claude-title-hook@herdr-claude-title-hook": true,
    "swift-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-code-plugins": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-code.git"
      }
    },
    "herdr-claude-title-hook": {
      "source": {
        "source": "github",
        "repo": "eduardoborges/herdr-claude-title-hook"
      }
    }
  },
  "language": "Portuguese",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-haiku-4-5": {},
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh",
      "autoCompactWindow": 600000
    },
    "claude-sonnet-5": {},
    "claude-sonnet-5-5": {}
  },
  "advisorModel": "fable",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "custom:draculinho",
  "editorMode": "normal",
  "verbose": false,
  "switchModelsOnFlag": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
