{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "mcp__plugin_cloudflare_cloudflare-api",
      "mcp__plugin_cloudflare_cloudflare-bindings",
      "mcp__plugin_cloudflare_cloudflare-builds",
      "mcp__plugin_cloudflare_cloudflare-observability",
      "mcp__claude_ai_Cloudflare_Developer_Platform"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/eduardo/Projects/Clawdmeter/daemon/attention-hook.sh alert"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/eduardo/Projects/Clawdmeter/daemon/attention-hook.sh clear"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/rtk hook claude"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/eduardo/Projects/Clawdmeter/daemon/attention-hook.sh alert"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/eduardo/Projects/Clawdmeter/daemon/attention-hook.sh tool"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/eduardo/.claude/hooks/journal.sh' end",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/eduardo/Projects/Clawdmeter/daemon/attention-hook.sh end"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/eduardo/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/eduardo/.claude/hooks/journal.sh' start",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "startup|resume|fork",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/eduardo/.claude/hooks/session-title.sh'",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/eduardo/Projects/Clawdmeter/daemon/attention-hook.sh stop"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/eduardo/Projects/Clawdmeter/daemon/attention-hook.sh clear"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "1password@1password": true,
    "atlassian@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "cloudflare@cloudflare": true,
    "code-review@claude-code-plugins": true,
    "herdr-claude-title-hook@herdr-claude-title-hook": true,
    "ponytail@ponytail": true,
    "swift-lsp@claude-plugins-official": true,
    "claude-animation@claude-animation-skill": true
  },
  "extraKnownMarketplaces": {
    "1password": {
      "source": {
        "source": "github",
        "repo": "1Password/1password-claude-plugin"
      }
    },
    "claude-code-plugins": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-code.git"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "herdr-claude-title-hook": {
      "source": {
        "source": "github",
        "repo": "eduardoborges/herdr-claude-title-hook"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "claude-animation-skill": {
      "source": {
        "source": "github",
        "repo": "buildwithhanif/claude-animation-skill"
      }
    }
  },
  "language": "Portuguese",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "high"
    },
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5": {},
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-sonnet-5-5": {},
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-haiku-4-5": {}
  },
  "advisorModel": "fable",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "custom:draculinho",
  "editorMode": "normal",
  "verbose": false,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
