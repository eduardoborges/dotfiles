{
  "advisorModel": "fable",
  "agentPushNotifEnabled": true,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "editorMode": "normal",
  "effortLevel": "xhigh",
  "enableAllProjectMcpServers": true,
  "enabledPlugins": {
    "atlassian@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "code-review@claude-code-plugins": true,
    "herdr-claude-title-hook@herdr-claude-title-hook": true,
    "swift-lsp@claude-plugins-official": true
  },
  "enableWorkflows": true,
  "extraKnownMarketplaces": {
    "claude-code-plugins": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-code.git"
      }
    },
    "herdr-claude-title-hook": {
      "source": {
        "repo": "eduardoborges/herdr-claude-title-hook",
        "source": "github"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "/bin/sh '/Applications/Claudio.app/Contents/Resources/attention-hook.sh' alert",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt|elicitation_dialog"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "/bin/sh '/Applications/Claudio.app/Contents/Resources/attention-hook.sh' clear",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/opt/homebrew/bin/rtk hook claude",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "/bin/sh '/Applications/Claudio.app/Contents/Resources/attention-hook.sh' alert",
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion"
      },
      {
        "hooks": [
          {
            "command": "/bin/sh '/Applications/Claudio.app/Contents/Resources/attention-hook.sh' tool",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "bash '/Users/eduardo/.claude/hooks/journal.sh' end",
            "timeout": 15,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "/bin/sh '/Applications/Claudio.app/Contents/Resources/attention-hook.sh' end",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/Users/eduardo/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^(startup|resume|clear|compact|fork)$"
      },
      {
        "hooks": [
          {
            "command": "bash '/Users/eduardo/.claude/hooks/journal.sh' start",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "startup|resume"
      },
      {
        "hooks": [
          {
            "command": "bash '/Users/eduardo/.claude/hooks/session-title.sh'",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|fork"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "/bin/sh '/Applications/Claudio.app/Contents/Resources/attention-hook.sh' stop",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "/bin/sh '/Applications/Claudio.app/Contents/Resources/attention-hook.sh' subagent",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "/bin/sh '/Applications/Claudio.app/Contents/Resources/attention-hook.sh' clear",
            "type": "command"
          }
        ]
      }
    ]
  },
  "inputNeededNotifEnabled": true,
  "language": "Portuguese",
  "model": "opus",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-haiku-4-5": {

    },
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-sonnet-5": {

    },
    "claude-sonnet-5-5": {

    }
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "mcp__claude_ai_Cloudflare_Developer_Platform"
    ]
  },
  "remoteControlAtStartup": true,
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "bash ~/.claude/statusline-command.sh",
    "type": "command"
  },
  "theme": "custom:draculinho",
  "tui": "fullscreen",
  "verbose": false,
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "voiceEnabled": true,
  "worktree": {
    "baseRef": "fresh"
  }
}
