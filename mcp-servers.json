{
  "firefox-devtools": {
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "@mozilla/firefox-devtools-mcp@latest",
      "--firefox-path",
      "/Applications/Firefox Developer Edition.app/Contents/MacOS/firefox",
      "--profile-path",
      "~/.cache/firefox-devtools-mcp",
      "--tool-preset",
      "developer"
    ],
    "env": {}
  },
  "figwright": {
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "@figwright/mcp@latest"
    ],
    "env": {}
  },
  "unsplash": {
    "type": "stdio",
    "command": "~/.local/share/unsplash-mcp/.venv/bin/python",
    "args": [
      "~/.local/share/unsplash-mcp/server.py"
    ],
    "env": {
      "UNSPLASH_ACCESS_KEY": "${UNSPLASH_ACCESS_KEY}"
    }
  },
  "dokploy": {
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "@dokploy/mcp@latest"
    ],
    "env": {
      "DOKPLOY_URL": "${DOKPLOY_URL}",
      "DOKPLOY_API_KEY": "${DOKPLOY_API_KEY}",
      "DOKPLOY_CUSTOM_HEADERS": "${DOKPLOY_CUSTOM_HEADERS}",
      "DOKPLOY_TOOL_PRESET": "core"
    }
  },
  "notion": {
    "type": "http",
    "url": "https://mcp.notion.com/mcp"
  },
  "taby": {
    "type": "http",
    "url": "http://127.0.0.1:43127/mcp",
    "headers": {
      "Authorization": "Bearer ${TABY_MCP_TOKEN}"
    }
  }
}
